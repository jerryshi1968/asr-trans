<Window x:Class="SystemSubtitleTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AppDisplayName}"
        Icon="Assets/app.ico"
        Width="860"
        Height="460"
        MinWidth="620"
        MinHeight="360"
        Background="#101217"
        Foreground="#F3F5F8"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding AppDisplayName}"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}"
                           Margin="0,4,0,0"
                           Foreground="#A8B0BD"
                           FontSize="13" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton"
                        Content="开始"
                        Width="92"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="StartButton_Click" />
                <Button x:Name="StopButton"
                        Content="停止"
                        Width="92"
                        Height="34"
                        IsEnabled="False"
                        Click="StopButton_Click" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#191D25" BorderBrush="#2A303B" BorderThickness="1" CornerRadius="6" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="识别原文"
                               Foreground="#A8B0BD"
                               FontSize="13"
                               Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SourceText}"
                                   FontSize="20"
                                   LineHeight="30"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Background="#1A221E" BorderBrush="#2E3A33" BorderThickness="1" CornerRadius="6" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="中文翻译"
                               Foreground="#A8B0BD"
                               FontSize="13"
                               Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding TranslationText}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   LineHeight="34"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="#788393"
                   Text="{Binding FooterText}"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
